{
  "name": "@xpresser/express-module",
  "version": "0.0.16",
  "description": "Xpresser [Express] v2 server module",
  "type": "module",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "main": "index.js",
  "types": "index.d.ts",
  "repository": "https://github.com/xpresserjs/express-server-module-provider",
  "author": "xpresserjs",
  "license": "MIT",
  "private": false,
  "scripts": {
    "watch": "npx tsc -w",
    "dev": "nodemon --exec npx ts-node-esm ./tests/test.ts server",
    "bun:dev": "bun run --watch ./tests/test.ts server",
    "test": "npx tsx bin/test.ts",
    "test:watch": "npx tsx --watch bin/test.ts",
    "prepublishOnly": "npx tsc && npm run test"
  },
  "dependencies": {
    "@xpresser/server-module": "0.0.16",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "moment": "^2.29.4"
  },
  "devDependencies": {
    "@japa/api-client": "^2.0.3",
    "@japa/assert": "^3.0.0",
    "@japa/runner": "^3.1.4",
    "@types/cors": "^2.8.15",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.3",
    "@xpresser/framework": "0.0.35",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "ts-node": "^10.9.1",
    "tsx": "^4.19.1",
    "typescript": "^5.2.2"
  }
}
